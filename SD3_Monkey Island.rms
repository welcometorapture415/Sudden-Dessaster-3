/* *** Monkey Island v2 *** */
/* Made by jasouki - July 2026 */
/* Only working for 1v1 games as of now */
/* v2 changes: corrected an error where extra outside berries did not spawn for one of the players in rare cases */

<PLAYER_SETUP>
 random_placement  
behavior_version 1


#const BLCKR1 1323 /* rock 2 */
#const BLCKR2 1308 /* smoke */
#const BLCKR3 623 /* rock 1 */
#const BLCKR4 2611 /* andean RUINS */
#const NNWR 82 /* NON NAVIGABLE WET ROCK BEACH */
#const ON_GRID 1543
#const NESSIE 1973
#const BCH 108 /* gravel beach */
#const T1 81 /* NNWG */
#const PL1 76 /* DIRT MUD */
#const MSK1 123 /* GRASS FLOWERS */
#const MSK2 102 /* DESERT GRAVEL */ 
#const MSK3 100 /* MUDDY_SHALLOW */
#const FOREST2 113 /* lush bamboo */
#const WATER2D 15

effect_amount GAIA_SET_ATTRIBUTE LUSH_BAMBOO_TREE ATTR_TERRAIN_ID 13


/* CONFIGURE CASTLE RUINS */

#const CASTLE_RUINS 251 /* AMPHITEATRE */
effect_amount SET_ATTRIBUTE CASTLE_RUINS ATTR_STANDING_GRAPHIC 12695
effect_amount SET_ATTRIBUTE CASTLE_RUINS ATTR_NAME_ID 21124
effect_amount SET_ATTRIBUTE CASTLE_RUINS ATTR_LINE_OF_SIGHT 3
effect_amount SET_ATTRIBUTE CASTLE_RUINS ATTR_SEARCH_RADIUS 1
effect_amount SET_ATTRIBUTE CASTLE_RUINS ATTR_RADIUS_1 2
effect_amount SET_ATTRIBUTE CASTLE_RUINS ATTR_RADIUS_2 2
effect_amount SET_ATTRIBUTE CASTLE_RUINS ATTR_ICON_ID 7

/* CONFIGURE PETARD */ 
#const PETARD2 440


effect_amount ENABLE_OBJECT PETARD2 ATTR_ENABLE 0
effect_amount SET_ATTRIBUTE PETARD2 ATTR_TRAIN_LOCATIONS_TOTAL_NUM 3
effect_amount SET_ATTRIBUTE PETARD2 ATTR_TRAIN_LOCATIONS_ENTRY_MOD 2
effect_amount SET_ATTRIBUTE PETARD2 ATTR_TRAIN_LOCATION CASTLE_RUINS
effect_amount SET_ATTRIBUTE PETARD2 ATTR_TRAIN_BUTTON 3
effect_amount SET_ATTRIBUTE PETARD2 ATTR_CREATION_TIME 40
effect_amount SET_ATTRIBUTE PETARD2 ATTR_BUTTON_ID 0

/* ************************************ */
<LAND_GENERATION>
#const BE 4

	start_random
		percent_chance 50 #define ANGLE1
		percent_chance 50 #define ANGLE2
	end_random
	
if ANGLE1
  #const P1NUMBER 1	
  #const P2NUMBER 2
  
elseif ANGLE2
  #const P1NUMBER 2	
  #const P2NUMBER 1
endif
  
base_terrain ICE


create_land { terrain_type DIRT base_elevation (BE + 1) land_position 50 50 land_percent 100 top_border 20 bottom_border 20 left_border 20 right_border 20 }


create_land { terrain_type GRASS base_elevation BE set_circular_base  base_size 21 assign_to_player P2NUMBER set_circular_base land_conformity 99 land_id 1 }
create_land { terrain_type DESERT base_elevation BE number_of_tiles 0 base_size 21 assign_to_player P2NUMBER set_circular_base land_conformity 99 }

create_land { terrain_type SNOW base_elevation BE number_of_tiles 0 base_size 21 assign_to_player P1NUMBER set_circular_base land_conformity 99 }
create_land { terrain_type GRASS base_elevation BE set_circular_base land_conformity 99 base_size 21 assign_to_player P1NUMBER land_id 1 }
create_land { terrain_type BLACK_WALKABLE base_elevation BE number_of_tiles 0 base_size 21 circle_radius 28 set_circular_base assign_to_player P1NUMBER  land_conformity 99 land_id 99 }

create_land { terrain_type FOREST2 base_elevation BE number_of_tiles 0 base_size 21 assign_to_player P2NUMBER set_circular_base land_conformity 99 }


/* **************************************** */
<TERRAIN_GENERATION>
color_correction CC_AUTUMN

/* FOREST2 */
create_terrain FOREST2
{
     base_terrain GRASS
     land_percent 100
     number_of_clumps 999
     set_scale_by_groups
	 set_avoid_player_start_areas 26
	 spacing_to_specific_terrain DIRT 5
}
/* making island */
create_terrain DLC_ROCK
{
     base_terrain BLACK_WALKABLE
     land_percent 100
     number_of_clumps 999
     spacing_to_specific_terrain GRASS 10
	 spacing_to_specific_terrain ICE 5
}

create_terrain GRASS
{
     base_terrain BLACK_WALKABLE
     land_percent 100
     number_of_clumps 999
     spacing_to_specific_terrain DLC_ROCK 2
}

create_terrain WATER
{
     base_terrain BLACK_WALKABLE
     land_percent 100
     number_of_clumps 999
}

create_terrain WATER2D
{  land_percent 100
   number_of_clumps 9999
  
  base_terrain WATER 
  spacing_to_specific_terrain GRASS 1

}

