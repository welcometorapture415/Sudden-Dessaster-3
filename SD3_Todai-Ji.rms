start_random
percent_chance 50 #const EYECANDYMID 2005
percent_chance 50 #const EYECANDYMID 1562
end_random

effect_amount SET_ATTRIBUTE BUILDING ATTR_FOUNDATION_TERRAIN 100
effect_amount SET_ATTRIBUTE PALMTREE ATTR_TERRAIN_ID 3
effect_amount SET_ATTRIBUTE FLAG_A ATTR_HITPOINTS 0
effect_amount SET_ATTRIBUTE WONDER ATTR_STANDING_GRAPHIC 3072
effect_amount SET_ATTRIBUTE WONDER ATTR_DYING_GRAPHIC 3059
effect_amount SET_ATTRIBUTE WONDER ATTR_STONE_COST 250
effect_amount SET_ATTRIBUTE WONDER ATTR_GOLD_COST 250
effect_amount SET_ATTRIBUTE WONDER ATTR_WOOD_COST 250
effect_amount SET_ATTRIBUTE WONDER ATTR_HITPOINTS 5800
effect_amount SET_ATTRIBUTE WONDER ATTR_TRAIN_LOCATION 0
effect_amount SET_ATTRIBUTE CITYWALL ATTR_ARMOR 1027
effect_amount SET_ATTRIBUTE CITYWALL ATTR_SHOWN_MELEE_ARMOR 3

guard_state WONDER AMOUNT_GOLD 0 1
/* rename the wonder to "defend the wonder" */
effect_amount SET_ATTRIBUTE WONDER ATTR_NAME_ID 9763

/* #define CITYWALLS uncomment if you want city walls */
start_random
percent_chance 0 #define ANGLE1 /* far wonder */
percent_chance 100 #define ANGLE2 /* closer wonder */
end_random
