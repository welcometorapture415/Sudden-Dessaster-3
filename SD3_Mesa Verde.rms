/*
v1.3
- Moved the TC 1 tile forward, to allow better villager access

v1.2
- Forage bushes outside the base now consistently generate with 7 bushes
- Fixed an issue where relics could be placed on the outside of the map

v1.2
- Removed the lumber camps
- Replaced the 4 tile stone inside the base with a 3 tile forage
- Added a 3 tile stone outside the base
- Sheep and pigs replaced by turkeys
- Improved the consistency of gold positioning
- Improved the consistency of woodlines

*/

/* #define 9_VIL_START */


/* terrains */
#const GRAVEL_GREY 70
#const BUSH_FOREST 89
#const PASTURE_DEAD 118

/* objects */
#const BUSH_A 302
#const FALCON 1056
#const LARGE_TEMP_REVEALER 1874
#const OWL 2490

/* actor areas */
#const AA_HOUSE 9000
#const AA_LUMBER_CAMP 9001
#const AA_9V_VIL 9002
#const AA_TC 9003
#const AA_WALL 9004

/* map scaling */
if MAPSIZE_NANO			#const RAW_LENGTH 36	#define 36x36	#define MEDIUM_OR_SMALLER #define TINY_OR_SMALLER	#define MINI_OR_SMALLER
elseif MAPSIZE_MICRO	#const RAW_LENGTH 60	#define 60x60	#define MEDIUM_OR_SMALLER #define TINY_OR_SMALLER	#define MINI_OR_SMALLER
elseif MAPSIZE_MINI		#const RAW_LENGTH 80	#define 80x80	#define MEDIUM_OR_SMALLER #define TINY_OR_SMALLER	#define MINI_OR_SMALLER
elseif MAPSIZE_PUNY		#const RAW_LENGTH 100	#define 100x100	#define MEDIUM_OR_SMALLER #define TINY_OR_SMALLER
elseif MAPSIZE_TINY		#const RAW_LENGTH 120	#define 120x120	#define MEDIUM_OR_SMALLER #define TINY_OR_SMALLER
elseif MAPSIZE_SMALL	#const RAW_LENGTH 144	#define 144x144 #define MEDIUM_OR_SMALLER
elseif MAPSIZE_MEDIUM	#const RAW_LENGTH 168	#define 168x168 #define MEDIUM_OR_SMALLER
elseif MAPSIZE_NORMAL	#const RAW_LENGTH 200	#define 200x200
elseif MAPSIZE_LARGE	#const RAW_LENGTH 220	#define 220x220
elseif MAPSIZE_HUGE		#const RAW_LENGTH 240	#define 240x240	#define HUGE_OR_LARGER
elseif MAPSIZE_GIANT	#const RAW_LENGTH 252	#define 252x252	#define HUGE_OR_LARGER
elseif MAPSIZE_MASSIVE	#const RAW_LENGTH 276	#define 276x276	#define HUGE_OR_LARGER
elseif MAPSIZE_ENORMOUS	#const RAW_LENGTH 300	#define 300x300	#define HUGE_OR_LARGER	#define ENORMOUS_OR_LARGER
elseif MAPSIZE_COLOSSAL	#const RAW_LENGTH 320	#define 320x320	#define HUGE_OR_LARGER	#define ENORMOUS_OR_LARGER
elseif MAPSIZE_INCREDIBLE	#const RAW_LENGTH 360	#define 360x360	#define HUGE_OR_LARGER	#define ENORMOUS_OR_LARGER	#define INCREDIBLE_OR_LARGER
elseif MAPSIZE_MONSTROUS	#const RAW_LENGTH 400	#define 400x400	#define HUGE_OR_LARGER	#define ENORMOUS_OR_LARGER	#define INCREDIBLE_OR_LARGER
elseif MAPSIZE_LUDICROUS	#const RAW_LENGTH 480	#define 480x480	#define HUGE_OR_LARGER	#define ENORMOUS_OR_LARGER	#define INCREDIBLE_OR_LARGER
endif

#const LENGTH (RAW_LENGTH * 1.1)
#const AREA (LENGTH * LENGTH)
#const SCALING_FACTOR (AREA / 10000)
override_map_size (LENGTH)

if 1_PLAYER_GAME	#const PLAYER_COUNT 1
elseif 2_PLAYER_GAME	#const PLAYER_COUNT 2
elseif 3_PLAYER_GAME	#const PLAYER_COUNT 3
elseif 4_PLAYER_GAME	#const PLAYER_COUNT 4
elseif 5_PLAYER_GAME	#const PLAYER_COUNT 5
elseif 6_PLAYER_GAME	#const PLAYER_COUNT 6
elseif 7_PLAYER_GAME	#const PLAYER_COUNT 7
elseif 8_PLAYER_GAME	#const PLAYER_COUNT 8
endif

/* =================================================================================================== */
<PLAYER_SETUP>

random_placement
behavior_version 2
ai_info_map_type CUSTOM 0 0 0

/* adjust starting resources */
if 9_VIL_START
	effect_amount MOD_RESOURCE AMOUNT_STARTING_WOOD ATTR_ADD -30
	effect_amount MOD_RESOURCE AMOUNT_STARTING_FOOD ATTR_ADD -90
endif

effect_amount GAIA_SET_ATTRIBUTE DLC_BOULDER_A ATTR_OCCLUSION_MODE 2
effect_amount GAIA_SET_ATTRIBUTE DLC_BOULDER_B ATTR_OCCLUSION_MODE 2
effect_amount GAIA_SET_ATTRIBUTE DLC_BOULDER_C ATTR_OCCLUSION_MODE 2

/* =================================================================================================== */
<LAND_GENERATION>

base_terrain PASTURE_DEAD

#const BORDER 20

/* center */
create_land {
	terrain_type DLC_DRYGRASS
	land_percent 100
	base_size (LENGTH / 4)
	set_circular_base
	land_position 50 50
	land_id 150
	zone 150
	left_border (BORDER) right_border (BORDER) top_border (BORDER) bottom_border (BORDER)
}

/* the playerlands */
create_player_lands {
	terrain_type DIRT3
	base_elevation 1
	base_size 14
	land_percent 100
	set_circular_base
	other_zone_avoidance_distance 4
	left_border (BORDER) right_border (BORDER) top_border (BORDER) bottom_border (BORDER)
	circle_radius (BORDER + 10) 0
}


/* helper lands to make sure the elevation generates properly */
create_land {
	terrain_type DLC_SAVANNAH
	base_elevation 10
	base_size 1
	land_percent 100
	land_position 0 0
	other_zone_avoidance_distance 6
}
create_land {
	terrain_type DLC_SAVANNAH
	base_elevation 10
	base_size 1
	land_percent 100
	land_position 0 98
	other_zone_avoidance_distance 6
}
create_land {
	terrain_type DLC_SAVANNAH
	base_elevation 10
	base_size 1
	land_percent 100
	land_position 99 0
	other_zone_avoidance_distance 6
}
create_land {
	terrain_type DLC_SAVANNAH
	base_elevation 10
	base_size 1
	land_percent 100
	land_position 99 98
	other_zone_avoidance_distance 6
}


/* =================================================================================================== */
<ELEVATION_GENERATION>

create_elevation 11 {
	base_terrain DLC_SAVANNAH
	enable_balanced_elevation
	number_of_tiles (AREA / 4)
	number_of_clumps (32 * SCALING_FACTOR)
	set_scale_by_groups
	spacing 1
}


/* =================================================================================================== */
<TERRAIN_GENERATION>

/* fix the slopes */
create_terrain PASTURE_DEAD { base_terrain DLC_DRYGRASS land_percent 100 number_of_clumps 9320 height_limits 2 16 }
create_terrain PASTURE_DEAD { base_terrain DLC_DRYGRASS land_percent 100 number_of_clumps 9320 height_limits 2 16 }
create_terrain PASTURE_DEAD { base_terrain DLC_DRYGRASS land_percent 100 number_of_clumps 9320 height_limits 2 16 }

create_terrain PASTURE_DEAD { base_terrain DIRT3 land_percent 100 number_of_clumps 9320 height_limits 2 16 }
create_terrain PASTURE_DEAD { base_terrain DIRT3 land_percent 100 number_of_clumps 9320 height_limits 2 16 }
create_terrain PASTURE_DEAD { base_terrain DIRT3 land_percent 100 number_of_clumps 9320 height_limits 2 16 }

create_terrain DIRT3 { base_terrain PASTURE_DEAD land_percent 100 number_of_clumps 9320 height_limits 0 1 }
create_terrain DIRT3 { base_terrain PASTURE_DEAD land_percent 100 number_of_clumps 9320 height_limits 0 1 }
create_terrain DIRT3 { base_terrain PASTURE_DEAD land_percent 100 number_of_clumps 9320 height_limits 0 1 }

create_terrain DIRT3 { base_terrain DLC_DRYGRASS land_percent 100 number_of_clumps 9320 height_limits 1 2 }
create_terrain DIRT3 { base_terrain DLC_DRYGRASS land_percent 100 number_of_clumps 9320 height_limits 1 2 }
create_terrain DIRT3 { base_terrain DLC_DRYGRASS land_percent 100 number_of_clumps 9320 height_limits 1 2 }

create_terrain DIRT3 { base_terrain PASTURE_DEAD land_percent 100 number_of_clumps 9320 height_limits 0 1 }


/* the center */
create_terrain GRASS3 { base_terrain DLC_DRYGRASS land_percent 100 number_of_clumps 9320 height_limits 0 0 spacing_to_other_terrain_types 1 set_flat_terrain_only }
create_terrain GRASS3 { base_terrain DLC_DRYGRASS land_percent 100 number_of_clumps 9320 height_limits 0 0 spacing_to_other_terrain_types 1 set_flat_terrain_only }
create_terrain GRASS3 { base_terrain DLC_DRYGRASS land_percent 100 number_of_clumps 9320 height_limits 0 0 spacing_to_other_terrain_types 1 set_flat_terrain_only }

create_terrain DIRT { base_terrain DLC_DRYGRASS land_percent 100 number_of_clumps 9320 height_limits 0 16 terrain_mask 1 }

create_terrain SOUTH_AMERICAN_FOREST {
	base_terrain DIRT3
	terrain_mask 2
	land_percent 100
	number_of_clumps 9320
	set_scale_by_groups
	spacing_to_other_terrain_types 0
	set_avoid_player_start_areas 20
}

/* scattered forests */
create_terrain SOUTH_AMERICAN_FOREST {
	base_terrain GRASS3
	terrain_mask 2
	land_percent 5
	number_of_clumps 18
	set_scale_by_groups
	spacing_to_other_terrain_types 0
	set_avoid_player_start_areas 20
}

