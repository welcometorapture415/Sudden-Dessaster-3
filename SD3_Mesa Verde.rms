/* =================================================================================================== */
<CONNECTION_GENERATION>

accumulate_connections

#const CONNECTION_WIDTH 5

create_connect_land_zones 150 -9 {
	replace_terrain SOUTH_AMERICAN_FOREST GRASS3
	replace_terrain BUSH_FOREST GRASS3
	terrain_cost DLC_SAVANNAH 0
	terrain_cost PASTURE_DEAD 0
	terrain_size SOUTH_AMERICAN_FOREST (CONNECTION_WIDTH) 0
	terrain_size BUSH_FOREST (CONNECTION_WIDTH) 0
	terrain_size GRASS3 (CONNECTION_WIDTH) 0
}
