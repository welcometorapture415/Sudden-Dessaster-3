effect_amount GAIA_SET_ATTRIBUTE REEDS_TREE ATTR_TERRAIN_ID 3 /* only water and beach */

endif

effect_amount GAIA_SET_ATTRIBUTE BENCH ATTR_STANDING_GRAPHIC 17032 /* give ES FLAG the Wooden Bench Graphics, because benches can't be build over, but allows units to pass through, kinda like ROCK1 except it's a unit */
effect_amount GAIA_SET_ATTRIBUTE DEAD_MONK ATTR_STANDING_GRAPHIC 995

effect_amount GAIA_SET_ATTRIBUTE KEG ATTR_BLAST_LEVEL 0
effect_amount GAIA_SET_ATTRIBUTE KEG ATTR_MAX_RANGE 4
effect_amount GAIA_SET_ATTRIBUTE KEG ATTR_BLAST_RADIUS 4
effect_amount GAIA_SET_ATTRIBUTE KEG ATTR_HITPOINTS 40
effect_amount GAIA_SET_ATTRIBUTE KEG ATTR_ADD_ATTACK_TYPE 6
effect_amount GAIA_SET_ATTRIBUTE KEG ATTR_ADD_ARMOR_TYPE 6

effect_amount GAIA_SET_ATTRIBUTE KEG ATTR_ATTACK 1064 /* = base melee (4) * 256 = 1024 + 40 damage - therefore 40 melee damage */
effect_amount GAIA_SET_ATTRIBUTE KEG ATTR_ATTACK 3056 /* = all buildings (11) * 256 = 2816 + 240 damage - therefore 240 building damage */
effect_amount GAIA_SET_ATTRIBUTE KEG ATTR_ATTACK 1786 /* = KEG (6) * 256 = 1536 + 250 damage - therefore 250 KEG damage */
effect_amount GAIA_SET_ATTRIBUTE KEG ATTR_ARMOR 772 /* 4 Pierce armor */







