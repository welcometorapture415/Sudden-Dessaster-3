/* Forgotten Empires - Hideout (Updated April 2020) */

/* Note: random_map.def is automatically included in every rms script */

/* Constants for inserting the Sudden Death Game Mode. */
#const TC_TECH 187
#const CUMAN_TC 218

/*
 * Checks conditions to defeat players if the game mode is not set
 * to random map. Includes a check for the secondary game mode checkboxes.
 */
if ANTIQUITY_MODE
  #define ADMIN_RESTART
elseif RANDOM_MAP
  if REGICIDE
    #define ADMIN_RESTART
  elseif EMPIRE_WARS
    #define ADMIN_RESTART
  elseif SUDDEN_DEATH
    #define ADMIN_RESTART
  endif
else
  #define ADMIN_RESTART
endif
if TINY_MAP
else
  #define ADMIN_RESTART
endif
if DEFAULT_RESOURCES
else
  #define ADMIN_RESTART
endif
if DARK_AGE_START
else
  #define ADMIN_RESTART
endif
if TURBO_MODE
  #define ADMIN_RESTART
endif
/*
 * If the lobby settings are detected as incorrect, the guard state is set to a
 * Saboteur, which is a unit with which players do not start the game and hence
 * are instantly defeated.
 * Otherwise sets the guard state object to a Town Center, enforcing the
 * Sudden Death condition.
 */
if ADMIN_RESTART
  #const GUARD_STATE_OBJECT SABOTEUR
else
  #const GUARD_STATE_OBJECT TOWN_CENTER
endif

#const PHON 1543

#const AA_HERD_START 20000
#const AA_HERD_B 20001

#const T1 rnd(0,359)
#const OFFSET rnd(135,225)
#const T2 (T1 + OFFSET)

#const R 20

#const R1 (T1 % 360 + 360 % 360 * -1 + 180)
#const S1 (R1 * 2 + 1 % 2)
#const P1 (180 * S1 - R1 * R1)
#const D1 (40500 - P1)
#const SIN1 (S1 * 4 * P1 / D1)
#const CR1 (270 - R1 % 360 * -1 + 180)
#const CS1 (CR1 * 2 + 1 % 2)
#const CP1 (180 * CS1 - CR1 * CR1)
#const CD1 (40500 - CP1)
#const COS1 (CS1 * 4 * CP1 / CD1)
#const X1 (R * COS1 + 50)
#const Y1 (R * SIN1 + 50)

#const R2 (T2 % 360 + 360 % 360 * -1 + 180)
#const S2 (R2 * 2 + 1 % 2)
#const P2 (180 * S2 - R2 * R2)
#const D2 (40500 - P2)
#const SIN2 (S2 * 4 * P2 / D2)
#const CR2 (270 - R2 % 360 * -1 + 180)
#const CS2 (CR2 * 2 + 1 % 2)
#const CP2 (180 * CS2 - CR2 * CR2)
#const CD2 (40500 - CP2)
#const COS2 (CS2 * 4 * CP2 / CD2)
#const X2 (R * COS2 + 50)
#const Y2 (R * SIN2 + 50)

<PLAYER_SETUP>
/*
 * Sets the Sudden Death Game Mode, or defeats players with incorrect
 * lobby settings.
 */
guard_state GUARD_STATE_OBJECT AMOUNT_GOLD 0 1 else
/* Disables the ability to construct additional Town Centers. */
effect_amount DISABLE_TECH TC_TECH ATTR_DISABLE 187
effect_amount MOD_RESOURCE CUMAN_TC ATTR_DISABLE 0
effect_amount SET_ATTRIBUTE TOWN_CENTER_FOUNDATION ATTR_TRAIN_LOCATION 0
effect_amount SET_ATTRIBUTE TOWN_CENTER_FOUNDATION_F ATTR_TRAIN_LOCATION 0
effect_amount SET_ATTRIBUTE TOWN_CENTER_FOUNDATION_C ATTR_TRAIN_LOCATION 0
effect_amount SET_ATTRIBUTE TOWN_CENTER_FOUNDATION_I ATTR_TRAIN_LOCATION 0

/* random_placement */
direct_placement
ai_info_map_type HIDEOUT 0 0 0

#include_drs thebr_setup.inc

/* PH SEASONS */
start_random
  percent_chance 20 #define PH_SPRING
  percent_chance 25 #define PH_ALPINE
  percent_chance 10 #define PH_TROPHICALSOUTH
  percent_chance 10 #define PH_TROPHICALEAST
  percent_chance 25 #define PH_FROZEN
  percent_chance 10 #define PH_MEDISOUTH
end_random

#define FROZEN_WESTONLY

/* Ensures only lureables with 340 Food are used. */
if PH_TROPHICALSOUTH
  #const LURABLE_A TAPIR
  #const LURABLE_B TAPIR
elseif PH_TROPHICALEAST
  #const LURABLE_A BOAR
  #const LURABLE_B BOAR
endif

#include_drs F_seasons.inc

<LAND_GENERATION>
base_terrain LAYER_A
enable_waves 0

create_land {
  land_position X1 Y1
  terrain_type LAYER_B
  assign_to AT_TEAM -10 0 0
  land_percent 8
  base_size 12
  top_border 18
  bottom_border 18
  right_border 18
  left_border 18
  clumping_factor 15
  other_zone_avoidance_distance 16
  zone 1
}

create_land {
  land_position X2 Y2
  terrain_type LAYER_B
  assign_to AT_TEAM -10 0 0
  land_percent 8
  base_size 12
  top_border 18
  bottom_border 18
  right_border 18
  left_border 18
  clumping_factor 15
  other_zone_avoidance_distance 16
  zone 2
}

