#include_drs F_seasons.inc

<PLAYER_SETUP>
direct_placement
ai_info_map_type ARENA 0 0 0 
behavior_version 1

override_map_size 168

start_random
	percent_chance 50 #define X
	percent_chance 50 #define PLUS 
end_random

